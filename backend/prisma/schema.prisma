// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id        Int           @id @default(autoincrement())
  email     String        @unique
  password  String
  createdAt DateTime      @default(now())
  matches   Match[]
  playerStats PlayerStats[]
  playerScores PlayerScore[]
}

model Match {
  id          Int      @id @default(autoincrement())
  matchType   String
  result      String
  createdAt   DateTime @default(now())

  // Team 1 (India) Stats
  team1Name      String
  team1Runs      Int
  team1Wickets   Int
  team1Overs     Float

  // Team 2 (Pakistan) Stats
  team2Name      String
  team2Runs      Int
  team2Wickets   Int
  team2Overs     Float

  // Match metadata
  totalOvers     Int
  maxWickets     Int

  user           User         @relation(fields: [userId], references: [id])
  userId         Int
  scores         PlayerScore[]
}

model PlayerScore {
  id       Int    @id @default(autoincrement())
  player   String
  team     String
  runs     Int
  balls    Int
  matchId  Int
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlayerStats {
  id        Int     @id @default(autoincrement())
  player    String
  team      String
  runs      Int      @default(0)
  balls     Int      @default(0)
  matches   Int      @default(0)
  strikeRate Float   @default(0.0)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([player, team, userId]) // each user has separate player stats
}
